# Pooled connection for the app, direct connection for migrations (from `neon env pull`).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Used only by `npm run db:seed`.
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=
# Bearer token the scheduler sends to /api/v1/cron/sync-applications (openssl rand -hex 32).
# On Vercel, CRON_SECRET is sent automatically as "Authorization: Bearer <value>".
CRON_SECRET=
# The Google Sheet with the listings (shared as "anyone with the link can view") and its tab.
# Used only by `npm run db:seed`, which creates the form if missing; afterwards edit it in the admin API.
GOOGLE_SHEET_URL=
GOOGLE_SHEET_NAME=
