erDiagram
    %% USER & AUTHORIZATION
    USERS {
        uuid id PK
        string email UK
        string password_hash
        string full_name
        enum role "superuser | admin | user"
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    SESSIONS {
        uuid id PK
        uuid user_id FK
        string token UK "SHA-256 hash of the cookie value"
        timestamp expires_at
        timestamp created_at
    }

    AUTH_ATTEMPTS {
        string key PK "action:ip-or-email"
        timestamp window_start
        integer count
    }

    %% NEWS MANAGEMENT
    NEWS {
        uuid id PK
        string slug UK
        string cover_image_url
        enum status "draft | published | archived"
        uuid author_id FK
        timestamp published_at
        timestamp created_at
        timestamp updated_at
    }

    NEWS_TRANSLATIONS {
        uuid id PK
        uuid news_id FK
        enum locale "en | kk | ru"
        string title
        text content
    }

    %% ARCHIVES MANAGEMENT
    ARCHIVES {
        uuid id PK
        string file_url
        string file_type
        integer file_size
        uuid uploaded_by FK
        timestamp created_at
        timestamp updated_at
    }

    ARCHIVE_TRANSLATIONS {
        uuid id PK
        uuid archive_id FK
        enum locale "en | kk | ru"
        string title
        text description
    }

    %% ADMIN-MANAGED APPLICATIONS
    APPLICATIONS {
        uuid id PK
        string title
        string category "Free text group label"
        text apply_url "External apply link"
        date deadline "Hidden after this day (Asia/Almaty)"
        enum status "open | closed"
        varchar[] countries "ISO alpha-2 codes, empty = online / any"
        jsonb fields "Ordered [{label, type, value, public}]"
        uuid created_by FK
        timestamp created_at
        timestamp updated_at
    }

    APPLICATION_SUBMISSIONS {
        uuid id PK
        uuid user_id FK
        uuid application_id FK
        enum status "pending | reviewed | accepted | rejected"
        jsonb data_snapshot "Title, category and public fields as they were when the user applied"
        timestamp created_at
        timestamp updated_at
    }

    %% RELATIONSHIPS
    USERS ||--o{ SESSIONS : "has"
    USERS ||--o{ NEWS : "authors"
    USERS ||--o{ ARCHIVES : "uploads"
    USERS ||--o{ APPLICATIONS : "creates"
    USERS ||--o{ APPLICATION_SUBMISSIONS : "submits"
    NEWS ||--o{ NEWS_TRANSLATIONS : "translated into"
    ARCHIVES ||--o{ ARCHIVE_TRANSLATIONS : "translated into"
    APPLICATIONS ||--o{ APPLICATION_SUBMISSIONS : "receives"
